+	/// Encrypts a confidential mail's bucket key for its internal recipients
+	/// (see `AsymmetricCryptoFacade::encrypt_bucket_key_for_internal_recipients`),
+	/// with the sender key pair the TS `MailFacade.addRecipientKeyData`
+	/// chooses: the user group's, or a shared mailbox's own when
+	/// `sender_mail_group_id` is not the user's mail group.
+	pub async fn encrypt_bucket_key_for_internal_recipients(
+		&self,
+		sender_mail_group_id: &GeneratedId,
+		bucket_key: &GenericAesKey,
+		recipient_mail_addresses: &[String],
+	) -> Result<Vec<InternalRecipientKey>, InternalRecipientKeyError> {
+		if self.user_facade.get_user().accountType == AccountType::EXTERNAL as i64 {
+			return Err(InternalRecipientKeyError::ExternalSender);
+		}
+		let own_mail_group_id = self
+			.user_facade
+			.get_membership_by_group_type(GroupType::Mail)
+			.map_err(AsymmetricCryptoError::from)?
+			.group;
+		let sender_group_id = if own_mail_group_id == *sender_mail_group_id {
+			self.user_facade.get_user_group_id()
+		} else {
+			sender_mail_group_id.clone()
+		};
+		self.asymmetric_crypto_facade
+			.encrypt_bucket_key_for_internal_recipients(
+				bucket_key,
+				recipient_mail_addresses,
+				&sender_group_id,
