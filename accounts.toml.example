# Hylki account configuration.
#
# Copy this file to ~/.config/hylki/accounts.toml and fill in your details.
# When this file is present and lists at least one account, Hylki connects over
# IMAP; otherwise it starts empty with an "Add account" prompt. (Most people just
# add accounts from the in-app Settings instead of editing this file.)
#
# NOTE: a `password` set here is migrated into the system keyring (secret-service)
# on first run and then removed from this file — passwords are never kept on disk.
# You can also just enter credentials in the in-app Settings. For Gmail, iCloud,
# etc. use an app-specific password.

[[accounts]]
name = "Personal"
email = "you@example.com"
imap_host = "imap.example.com"
imap_port = 993            # optional, defaults to 993 (implicit TLS)
smtp_host = "smtp.example.com"  # optional, derived from imap_host if omitted
smtp_port = 587            # optional, defaults to 587 (STARTTLS; use 465 for implicit TLS)
username = "you@example.com"
password = "app-specific-password"

# Common servers:
#   Gmail   imap.gmail.com           (requires an app password)
#   iCloud  imap.mail.me.com         (requires an app-specific password)
#   Outlook outlook.office365.com
#   Fastmail imap.fastmail.com
#
# Proton Mail can be reached two ways. Through Proton Bridge running on this
# machine, as an IMAP account: take the host, ports and generated password
# from the Bridge window:
#
#   imap_host = "127.0.0.1"
#   imap_port = 1143         # STARTTLS; Bridge's default
#   smtp_host = "127.0.0.1"
#   smtp_port = 1025
#
# Bridge presents a certificate it signed itself, which is accepted for
# 127.0.0.1/localhost only — connections to any other host are fully verified.
#
# Tuta has no IMAP or SMTP; Hylki reaches it through its bundled hylki-tuta
# helper. Add it from Settings or the welcome wizard (Provider: Tuta), which
# signs in and keeps the session in the keyring. The password is never stored,
# here or in the keyring, so a stanza written by hand only names the account
# and still has to be signed in from Settings:
#
#   [[accounts]]
#   name = "Tuta"
#   email = "you@tuta.com"
#   protocol = "tuta"
#   imap_host = ""           # no server: the helper knows Tuta's
#   username = "you@tuta.com"
#
# Proton Mail also works without Bridge, through the bundled hylki-proton
# helper. Add it from Settings or the welcome wizard (Provider: Proton Mail),
# which signs in, asks for an authenticator code, a mailbox password or a
# CAPTCHA when the account needs one, and keeps the session in the keyring.
# Neither password is ever stored, so a stanza written by hand only names the
# account and still has to be signed in from Settings:
#
#   [[accounts]]
#   name = "Proton"
#   email = "you@proton.me"
#   protocol = "proton"
#   imap_host = ""           # no server: the helper knows Proton's
#   username = "you@proton.me"
