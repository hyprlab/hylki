msgstr "Μια επαφή χρειάζεται όνομα, διεύθυνση email ή αριθμό τηλεφώνου"

msgid "The contact is too large"
msgstr "Η επαφή είναι υπερβολικά μεγάλη"

msgid "UTF-16 files are not supported"
msgstr "Δεν υποστηρίζονται αρχεία UTF-16"

msgid "The file is not a text file"
msgstr "Το αρχείο δεν είναι αρχείο κειμένου"

