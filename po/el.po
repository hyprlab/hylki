msgstr ""
"Διαχειρίζεται από τους Διαδικτυακούς λογαριασμούς GNOME. Η διεύθυνση, οι "
"διακομιστές και ο κωδικός πρόσβασης αλλάζουν στις Ρυθμίσεις → Διαδικτυακοί "
"λογαριασμοί."

msgid "Storage"
msgstr "Αποθήκευση"

msgid "Mail Account"
msgstr "Λογαριασμός αλληλογραφίας"

msgid "Display Name"
msgstr "Εμφανιζόμενο όνομα"

msgid "Email Address"
msgstr "Διεύθυνση email"

msgid "Incoming Protocol"
msgstr "Πρωτόκολλο εισερχομένων"

msgid "SMTP Server (optional)"
msgstr "Διακομιστής SMTP (προαιρετικό)"

msgid "SMTP Port (default 587)"
msgstr "Θύρα SMTP (προεπιλογή 587)"

msgid "Username"
msgstr "Όνομα χρήστη"

msgid "Sign in with an API token"
msgstr "Σύνδεση με διακριτικό API"

