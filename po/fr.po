msgid "Welcome to Hylki"
msgstr "Bienvenue dans Hylki"

msgid ""
"A clean, fast home for your mail.\n"
"Let's set things up — it takes about a minute."
msgstr ""
"Un espace épuré et rapide pour vos e-mails.\n"
"Configurons tout cela — cela prend environ une minute."

msgid ""
"Choosing another language restarts Hylki: it closes for a moment and this "
"wizard comes back in that language."
msgstr ""
"Le choix d'une autre langue redémarre Hylki : il se ferme un instant et cet "
"assistant revient dans cette langue."

msgid "Get Started"
msgstr "Commencer"

msgid "Add your email account"
msgstr "Ajoutez votre compte e-mail"

msgid "Found in GNOME Online Accounts"
msgstr "Trouvé dans GNOME Comptes en ligne"

msgid "Your name"
msgstr "Votre nom"

