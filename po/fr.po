msgstr ""
"Profitez-en bien ! Si vous rencontrez un problème ou désirez une "
"fonctionnalité,\n"
"veuillez ouvrir un ticket sur notre <a href=\"{url}\">GitHub</a>."

msgid "Start Reading"
msgstr "Commencer la lecture"

