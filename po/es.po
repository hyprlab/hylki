msgid_plural "Downloading attachments… {n} remaining"
msgstr[0] "Descargando archivos adjuntos… queda {n}"
msgstr[1] "Descargando archivos adjuntos… quedan {n}"

msgid "“{subject}” will be sent {when}"
msgstr "«{subject}» se enviará {when}"

msgid "Could not schedule the message: there is no local store to keep it in."
msgstr ""
"No se pudo programar el mensaje: no hay ningún almacenamiento local donde "
"conservarlo."

msgid ""
"no OpenPGP key of your own for {addr}; generate one under Settings, OpenPGP"
msgstr ""
"no tienes ninguna clave OpenPGP propia para {addr}; genera una en Ajustes → "
"OpenPGP"

