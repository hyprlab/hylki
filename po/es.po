msgstr "No se pudo eliminar definitivamente: {e}"

msgid "Could not move folder: {e}"
msgstr "No se pudo mover la carpeta: {e}"

msgid "Message sent, but saving to Sent failed: {e}"
msgstr "Mensaje enviado, pero no se pudo guardar en Enviados: {e}"

msgid "Connecting to {host}…"
msgstr "Conectando con {host}…"

