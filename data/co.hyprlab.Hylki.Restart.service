# Restart helper (src/app_icon.rs): activating this name starts a fresh
# sandbox instance that waits for the running app to quit, then becomes the
# new one. Flatpak rewrites Exec to `flatpak run … --command=hylki` on export.
[D-BUS Service]
Name=co.hyprlab.Hylki.Restart
Exec=/app/bin/hylki --restart-helper
