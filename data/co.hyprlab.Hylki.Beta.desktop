[Desktop Entry]
Name=Hylki (beta)
GenericName=Email Client
Comment=A clean, fast GNOME-native email client — beta channel
# %U, not %u: a file manager hands every selected file to one launch, so
# they all land in the same message ("Send with Hylki" from GNOME Files).
Exec=hylki %U
Icon=co.hyprlab.Hylki.Beta
Terminal=false
Type=Application
Categories=GNOME;GTK;Network;Email;
Keywords=Email;Mail;IMAP;
MimeType=x-scheme-handler/mailto;x-scheme-handler/mid;message/rfc822;application/vnd.ms-outlook;
StartupNotify=true
StartupWMClass=co.hyprlab.Hylki.Beta
Actions=new-message;contacts;attachments;

[Desktop Action new-message]
Name=New Message
Exec=hylki mailto:

[Desktop Action contacts]
Name=Contacts
Exec=hylki --contacts

[Desktop Action attachments]
Name=Attachments
Exec=hylki --attachments
