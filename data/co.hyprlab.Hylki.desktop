[Desktop Entry]
Name=Hylki
GenericName=Email Client
Comment=A fast, GNOME-native email client, built with Rust and libadwaita. Open source and private by default.
# %U, not %u: a file manager hands every selected file to one launch, so
# they all land in the same message ("Send with Hylki" from GNOME Files).
Exec=hylki %U
Icon=co.hyprlab.Hylki
Terminal=false
Type=Application
Categories=GNOME;GTK;Network;Email;
Keywords=Email;Mail;IMAP;
MimeType=x-scheme-handler/mailto;x-scheme-handler/mid;
StartupNotify=true
StartupWMClass=co.hyprlab.Hylki
Actions=new-message;
# Earlier names, for desktops that carry favourites across a rename.
X-Flatpak-RenamedFrom=co.hyprlab.Vireo.desktop;com.getveem.Veem.desktop;

[Desktop Action new-message]
Name=New Message
Exec=hylki mailto:
